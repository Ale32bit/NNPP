@using NNPP.Models
@using NNPP.Reactor
@inject Simulation Sim

<div class="alarm @(Enable ? "show" : "")" style="--interval: @(Interval)s; --color: @Color;"></div>

@code {
    public bool Enable { get; set; }
    public double Interval { get; set; } = 10;
    public string Color { get; set; } = "red";

    protected override void OnInitialized()
    {
        Sim.OnAlarmLightSet += (_, setting) => OnAlarmLightSet(setting);
    }
    
    private void OnAlarmLightSet(AlarmLightSetting setting)
    {
        Enable = setting.Enable;
        Interval = setting.Interval;
        Color = setting.Color;
        StateHasChanged();
    }
}