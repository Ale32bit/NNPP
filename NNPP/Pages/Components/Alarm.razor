@using NNPP.Models
@using NNPP.Reactor
@inject Simulation Sim

<div class="alarm @(Enable ? "show" : "")" style="--interval: @(Interval)s; --color: @Color;"></div>

@code {
    public bool Enable { get; set; }
    public double Interval { get; set; } = 10;
    public string Color { get; set; } = "red";

    private ReactorStatus _status = ReactorStatus.Offline;

    protected override void OnInitialized()
    {
        Sim.OnUpdate += (_, dt) => OnUpdate(dt);
    }

    private void OnUpdate(double dt)
    {
        if (_status == Sim.ReactorStatus.Value)
        {
            return;
        }

        _status = Sim.ReactorStatus.Value;
        switch (_status)
        {
            case ReactorStatus.Overheat:
                Enable = true;
                Interval = 10;
                Color = "orange";
                break;
            case ReactorStatus.Emergency or ReactorStatus.Error:
                Enable = true;
                Interval = 5;
                Color = "red";
                break;
            default:
                Enable = false;
                break;
        }

        StateHasChanged();
    }

}