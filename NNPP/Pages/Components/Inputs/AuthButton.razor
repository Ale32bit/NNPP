@using NNPP.Models.Inputs

<div title="@Tooltip" class="frame">
    <div class="body">
        <div role="button" class="button" @onclick="() => Button.Enable()"></div>
    </div>
    <div class="status" style="--status-color: @GetStatusColor()"></div>
    <div class="label"><span>@Label</span></div>
</div>

@code {
    [Parameter, EditorRequired] public required Models.Inputs.AuthButton Button { get; set; }
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Tooltip { get; set; } = "";

    public string GetStatusColor()
    {
        if (Button.Enabled)
        {
            return "#00FF00";
        }

        if (Button.Available)
        {
            return "#FF0000";
        }

        return "#000000";
    }

}