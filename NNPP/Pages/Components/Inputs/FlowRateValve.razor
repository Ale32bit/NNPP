@using NNPP.Audio
@using NNPP.Models.Inputs
@inject AudioManager Audio

<div class="frame">
    @if (!string.IsNullOrEmpty(Label))
    {
        <div class="label">
            <span>@Label</span>
        </div>
    }
    <div class="switch">
        <span style="--a:-60deg">––</span>
        <span style="--a:-30deg">–</span>
        <span style="--a:0deg">•</span>
        <span style="--a:30deg">+</span>
        <span style="--a:60deg">++</span>
        <div class="knob" style="transform: @Transform;"></div>
        <div class="interact-box">
            <div class="interact" @onclick="TurnLeft" title="Decrease"></div>
            <div class="interact" @onclick="TurnRight" title="Increase"></div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public required RateSwitch Switch { get; set; }
    
    [Parameter] public string? Label { get; set; }

    private string Transform => $"rotate({(Switch.Value) * 30}deg)";
    
    public void TurnLeft()
    {
        SwitchKnob(-1);
    }

    public void TurnRight()
    {
        SwitchKnob(1);
    }

    private void SwitchKnob(int step)
    {
        var value = Math.Clamp(Switch.Value + step, -2, 2);
        Switch.Position = (RateSwitch.SwitchPosition)value;
        Audio.Interact();
    }
}
