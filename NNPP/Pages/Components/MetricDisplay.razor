@using NNPP.Models

<div class="parameter" style="grid-area: @GridAreaName">
    @if (Parameter is Metric { Unit: not null } metric && ShowLabelUnit)
    {
        <p class="label">@((Label ?? metric.Label).ToUpperInvariant()) (@metric.Unit)</p>
    }
    else
    {
        <p class="label">@((Label ?? Parameter.Label).ToUpperInvariant())</p>
    }
    <p class="value">@Parameter.GetValue()</p>
</div>

@code {
    [Parameter, EditorRequired] public required IParameter Parameter { get; set; }
    [Parameter] public bool ShowLabelUnit { get; set; } = true;

    [Parameter] public int Index { get; set; } = 1;
    
    /// <summary>
    /// Override metric label to display
    /// </summary>
    [Parameter] public string? Label { get; set; }
    
    private string GridAreaName => $"m{Index}";
}