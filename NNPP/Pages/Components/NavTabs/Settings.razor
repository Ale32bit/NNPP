@using NNPP.Reactor
@inject Simulation Sim
@inject AudioManager Audio

<div>
    <label>Master volume (@MasterVolume.ToString("P0"))</label>
    <input class="slider" type="range" min="0" max="1" step="0.01" @bind="MasterVolume"/>
</div>

<div>
    <label>Music volume (@MusicVolume.ToString("P0"))</label>
    <input class="slider" type="range" min="0" max="1" step="0.01" @bind="MusicVolume"/>
</div>

<div>
    <label>SFX volume (@SfxVolume.ToString("P0"))</label>
    <input class="slider" type="range" min="0" max="1" step="0.01" @bind="SfxVolume"/>
</div>

@code {

    private double MasterVolume
    {
        get;
        set
        {
            field = value;
            UpdateMasterVolume();
        }
    } = 0.5;

    private double AlarmsVolume
    {
        get;
        set
        {
            field = value;
            UpdateAlarmsVolume();
        }
    } = 1;

    private double MusicVolume
    {
        get;
        set
        {
            field = value;
            UpdateMusicVolume();
        }
    } = 1;

    private double SfxVolume
    {
        get;
        set
        {
            field = value;
            UpdateSfxVolume();
        }
    } = 0.2;

    private bool _started;

    protected override void OnInitialized()
    {
        Sim.OnUpdate += (_, _) =>
        {
            if (!_started)
            {
                UpdateMasterVolume();
                UpdateAlarmsVolume();
                UpdateMusicVolume();
                UpdateSfxVolume();
                _started = true;
            }
        };
    }

    private void UpdateMasterVolume()
    {
        Audio.SetVolumeAsync(AudioManager.AudioBus.Master, MasterVolume);
    }

    private void UpdateAlarmsVolume()
    {
        //Audio.SetVolumeAsync(AudioManager.AudioBus.Master, MasterVolume);
    }

    private void UpdateMusicVolume()
    {
        Audio.SetVolumeAsync(AudioManager.AudioBus.Music, MusicVolume);
    }

    private void UpdateSfxVolume()
    {
        Audio.SetVolumeAsync(AudioManager.AudioBus.Sfx, SfxVolume);
    }

}