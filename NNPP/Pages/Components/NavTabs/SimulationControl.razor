@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@using NNPP.Reactor
@inject Simulation Sim
@inject IWebAssemblyHostEnvironment Env

@if (Sim.Tainted())
{
    <p style="background-color: #ff5555;"><b>Simulation tainted, XP disabled.</b></p>
}
else
{
    <p><b>Using these controls will disable XP gain.</b></p>
}

<div>
    <label>Reactor Temperature (K)</label>
    <input @bind="Temperature" type="number"/>
    <button @onclick="SetTemperature">SET</button>
</div>

<div>
    <label>Fuel (%)</label>
    <input @bind="Fuel" type="number"/>
    <button @onclick="SetFuel">SET</button>
</div>

<div>
    <label>Rod Insertion (%)</label>
    <input @bind="RodInsertion" type="number"/>
    <button @onclick="SetRodInsertion">SET</button>
</div>

<div>
    <button @onclick="TriggerMeltdown">Trigger meltdown</button>
    <button @onclick="ToggleReactor">Toggle reactor</button>
    <button @onclick="ForceSyncTurbines">Force sync turbines</button>
    <button @onclick="OperationPreset">Operation preset</button>
    <button @onclick="TriggerHostileAttack">Trigger hostile attack</button>
</div>

@if (Env.IsDevelopment())
{
    <div>
        <h4>Debug</h4>
        
        <button @onclick="Sim.Turbine1.Break">Break Turbine 1</button>
        <button @onclick="Sim.Turbine2.Break">Break Turbine 2</button>
        
        <button @onclick="Sim.FeedwaterPump1.Break">Break Feedwater 1</button>
        <button @onclick="Sim.FeedwaterPump2.Break">Break Feedwater 2</button>
        
        <button @onclick="Sim.Grid.Generators[0].Break">Break Gen 1</button>
        <button @onclick="Sim.Grid.Generators[1].Break">Break Gen 2</button>
        <button @onclick="Sim.Grid.Generators[2].Break">Break Gen 3</button>
    </div>
}

@code {
    private bool _tainted = false;
    private string TaintedClass => _tainted ? "tainted" : "";

    private double Temperature { get; set; } = Parameters.Core.StallTemp;
    private double Fuel { get; set; } = 100;
    private double RodInsertion { get; set; } = 100;

    public void SetTemperature()
    {
        Taint();
        Sim.ReactorTemperature.Value = Temperature;
    }

    public void SetFuel()
    {
        Taint();
        Sim.Fuel.Value = Fuel / 100d;
    }

    public void SetRodInsertion()
    {
        Taint();
        Sim.RodInsertion.Value = RodInsertion / 100d;
    }

    public void TriggerMeltdown()
    {
        Taint();
        Sim.TriggerMeltdown();
    }

    public void ToggleReactor()
    {
        Taint();
        Sim.Running = !Sim.Running;
        Sim.RodControl.Locked = !Sim.Running;
    }

    public void ForceSyncTurbines()
    {
        Taint();
        Sim.Turbine1.Phase = 0;
        Sim.Turbine1.FlowRate.Value = Parameters.Turbine.SyncFlow;
        Sim.Turbine1.Valve.Value = 1;
        Sim.Turbine1.Rpm.Value = Parameters.Turbine.SyncRpm;
        Sim.AttemptTurbineSync(Sim.Turbine1);

        Sim.Turbine2.Phase = 0;
        Sim.Turbine2.FlowRate.Value = Parameters.Turbine.SyncFlow;
        Sim.Turbine2.Valve.Value = 1;
        Sim.Turbine2.Rpm.Value = Parameters.Turbine.SyncRpm;
        Sim.AttemptTurbineSync(Sim.Turbine2);
    }

    public void OperationPreset()
    {
        Taint();
        Sim.Running = true;
        Sim.ReactorTemperature.Value = 1420;
        Sim.RodControl.Locked = false;
        Sim.RodInsertion.Value = 0.55;
        Sim.FeedwaterPump1.Rpm.Value = Parameters.Feedwater.MaxRpm * Sim.FeedwaterPump1.Utilization.Value;
        Sim.FeedwaterPump2.Rpm.Value = Parameters.Feedwater.MaxRpm * Sim.FeedwaterPump2.Utilization.Value;
    }
    
    public void TriggerHostileAttack()
    {
        Taint();
        Sim.RandomHostileCooldown = 0;
    }

    private void Taint()
    {
        _tainted = true;
        Sim.Taint();
    }
}