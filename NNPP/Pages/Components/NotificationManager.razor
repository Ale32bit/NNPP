@using NNPP.Models
@using NNPP.Reactor
@implements IDisposable
@inject Simulation Sim
@inject AudioManager Audio

<div class="notifications">
    @foreach (var entry in _notifications)
    {
        <div class="notification @entry.Class" @key="entry">
            <div class="data">
                <h3>@entry.Data.Title</h3>
                <p>@entry.Data.Message</p>
            </div>
        </div>
    }
</div>

@code {

    private sealed class Entry(Notification notification)
    {
        public Notification Data { get; set; } = notification;
        public string Class { get; set; } = "hide";
    }

    private List<Entry> _notifications = [];
    private readonly CancellationTokenSource _cts = new();

    protected override void OnInitialized()
    {
        Sim.OnNotification += OnNotification;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Audio.PreloadAsync(AudioKeys.Sfx.Notification, AudioKeys.Sfx.NotificationCritical);
        }
    }

    private void OnNotification(object? sender, Notification e)
    {
        InvokeAsync(() => Add(e));
    }

    private async Task Add(Notification notification)
    {
        var entry = new Entry(notification);
        _notifications.Add(entry);
        StateHasChanged();

        if (!notification.Silent)
        {
            if (notification.Critical)
            {
                await Audio.StopSfxAsync(AudioKeys.Sfx.NotificationCritical);
                await Audio.PlaySfxAsync(AudioKeys.Sfx.NotificationCritical);
            }
            else
            {
                await Audio.StopSfxAsync(AudioKeys.Sfx.Notification);
                await Audio.PlaySfxAsync(AudioKeys.Sfx.Notification);
            }
        }

        await Task.Delay(10, _cts.Token);
        entry.Class = "";
        StateHasChanged();

        if (notification.Permanent)
        {
            return;
        }

        try
        {
            await Task.Delay(TimeSpan.FromSeconds(10), _cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        entry.Class = "hide";
        await Task.Delay(500, _cts.Token);
        _notifications.Remove(entry);
        StateHasChanged();
    }

    public void Dispose()
    {
        Sim.OnNotification -= OnNotification;
        _cts.Cancel();
        _cts.Dispose();
    }

}