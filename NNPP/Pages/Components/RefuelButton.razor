@using Microsoft.AspNetCore.Components.Infrastructure
@using NNPP.Reactor
@inject Simulation Sim

<button class="action @Disabled" @onclick="Refuel" @(Disabled)><img src="assets/fuel.svg" alt="wrench"/>Refuel @Label @CooldownText</button>

@code {
    [Parameter, EditorRequired] public Action Callback { get; set; }
    [Parameter] public required string Label { get; set; }

    [Parameter] public double CooldownDuration { get; set; } = 3; // seconds
    [Parameter] public Func<bool>? Condition { get; set; }
    private double _cooldown = 0;
    private bool _refueling = false;

    private string Disabled => _cooldown > 0 || Condition?.Invoke() == false ? "disabled" : "";

    private string CooldownText => _refueling ? $"({_cooldown:F0}s)" : "";

    protected override void OnInitialized()
    {
        Sim.OnUpdate += (_, dt) =>
        {
            if (!_refueling) return;
            _cooldown -= dt;

            if (_cooldown <= 0)
            {
                _refueling = false;
                Callback();
            }
        };
    }

    public void Refuel()
    {
        if (!string.IsNullOrEmpty(Disabled))
            return;

        _cooldown = CooldownDuration;
        _refueling = true;
    }

}