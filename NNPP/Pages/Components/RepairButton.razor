@using Microsoft.AspNetCore.Components.Infrastructure
@using NNPP.Reactor
@inject Simulation Sim

<button class="action @Disabled" @onclick="Repair" @(Disabled)><img src="assets/wrench.svg" alt="wrench"/>Repair @Label @CooldownText</button>

@code {
    [Parameter, EditorRequired] public Action Callback { get; set; }
    [Parameter] public string Label { get; set; }

    private static readonly double CooldownDuration = 3; // seconds
    private double _cooldown = 0;
    private bool _repairing = false;

    private string Disabled => _cooldown > 0 ? "disabled" : "";
    
    private string CooldownText => _repairing ? $"({_cooldown:F0}s)" : "";

    protected override void OnInitialized()
    {
        Sim.OnUpdate += (_, dt) =>
        {
            if (!_repairing) return;
            _cooldown -= dt;

            if (_cooldown <= 0)
            {
                _repairing = false;
                Callback();
            }
        };
    }

    public void Repair()
    {
        if (_cooldown > 0)
            return;

        _cooldown = CooldownDuration;
        _repairing = true;
    }

}