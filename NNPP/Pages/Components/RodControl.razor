@using NNPP.Models.Inputs
@using NNPP.Reactor

<div class="rods">
    <button class="action" @onclick="StepUp">RAISE (Q)</button>

    <input disabled id="range" type="range" min="-1" max="1" step="1" value="@Value">

    <button class="action" @onclick="StepDown">LOWER (E)</button>
</div>

@code {
    [Parameter, EditorRequired] public required RodController Control { get; set; }
    [Parameter, EditorRequired] public required Simulation Simulation { get; set; }

    private int Value => (int)Control.Position;

    protected override void OnInitialized()
    {
        Simulation.KeyPress += (_, key) =>
        {
            switch (key.Key)
            {
                case "e":
                    StepDown();
                    break;
                case "q":
                    StepUp();
                    break;
            }
        };
    }

    private void StepUp()
    {
        if (!Control.Locked)
        {
            Control.Position = Control.Position switch
            {
                RodController.ControlPosition.Lowering => RodController.ControlPosition.Neutral,
                RodController.ControlPosition.Neutral => RodController.ControlPosition.Raising,
                _ => Control.Position
            };

            
        }
    }

    private void StepDown()
    {
        if (!Control.Locked)
        {
            Control.Position = Control.Position switch
            {
                RodController.ControlPosition.Raising => RodController.ControlPosition.Neutral,
                RodController.ControlPosition.Neutral => RodController.ControlPosition.Lowering,
                _ => Control.Position
            };
        }
    }

}